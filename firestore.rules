rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Pending self-registrations never confer application privileges.
    function role(value) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().get('role', '') == value
        && profile().get('status', '') == 'approved';
    }
    function admin() { return role('admin'); }
    function college(data) {
      return role('college') && profile().get('collegeId', '') is string
        && profile().get('collegeId', '') != '' && data.collegeId == profile().collegeId;
    }
    function district(data) {
      return (role('deo') || role('diet')) && profile().districtId != ''
        && data.districtId == profile().districtId;
    }
    function school(data) {
      return role('school') && profile().schoolId != ''
        && data.schoolId == profile().schoolId;
    }
    function studentReadable(data) {
      return college(data) || district(data)
        || (role('school') && profile().schoolId != ''
          && data.finalSchoolId == profile().schoolId);
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function eligibilityReviewAudit(data) {
      return {
        'status': data.status,
        'eligible': data.eligible,
        'reviewedBy': data.reviewedBy,
        'reviewedAt': data.reviewedAt,
        'dietRemarks': data.dietRemarks
      };
    }
    function validExamEligibilitySubmission(data, submissionId) {
      let studentPath = /databases/$(database)/documents/students/$(data.studentId);
      return data.keys().hasOnly(['submissionId', 'examCycle', 'studentId',
          'registrationId', 'studentName', 'collegeId', 'districtId', 'dietId',
          'totalWorkingDays', 'attendedWorkingDays', 'attendancePercentage',
          'tpCertificateFileName', 'tpCertificateMimeType', 'tpCertificatePdf',
          'collegeRemarks', 'status', 'submittedBy', 'submittedAt', 'reviewedBy',
          'reviewedAt', 'dietRemarks', 'eligible', 'reviewHistory', 'updatedAt'])
        && data.submissionId == submissionId
        && submissionId == 'october_2026_' + data.studentId
        && data.examCycle == 'october_2026'
        && data.studentId is string && data.studentId != ''
        && data.registrationId is string && data.registrationId != ''
        && data.studentName is string && data.studentName != ''
        && data.totalWorkingDays == 200
        && data.attendedWorkingDays is int
        && data.attendedWorkingDays >= 0 && data.attendedWorkingDays <= 200
        && data.attendancePercentage is number
        && data.attendancePercentage * 2 == data.attendedWorkingDays
        && data.tpCertificateFileName is string && data.tpCertificateFileName != ''
        && data.tpCertificateMimeType == 'application/pdf'
        && data.tpCertificatePdf is bytes
        && data.collegeRemarks is string
        && data.status == 'submitted_to_diet'
        && data.submittedBy == request.auth.uid
        && data.submittedAt == request.time
        && data.updatedAt == request.time
        && data.reviewedBy == null && data.reviewedAt == null
        && data.dietRemarks == null && data.eligible == null
        && data.get('reviewHistory', []) is list
        && exists(studentPath)
        && college(get(studentPath).data)
        && get(studentPath).data.collegeId == data.collegeId
        && get(studentPath).data.districtId == data.districtId;
    }
    function correctionSubmission(studentId) {
      let next = request.resource.data;
      let path = /databases/$(database)/documents/correction_requests/$(next.correctionRequestId);
      let correction = getAfter(path).data;
      return college(resource.data)
        && resource.data.get('correctionRequestStatus', '') in ['', 'rejected']
        && changedOnly(['correctionRequestId', 'correctionRequestStatus',
          'correctionRequestedAt', 'correctionRejectedAt',
          'correctionRejectedRemarks', 'correctionApprovedAt', 'updatedAt'])
        && next.correctionRequestStatus == 'pending'
        && !exists(path)
        && correction.studentId == studentId
        && correction.collegeId == resource.data.collegeId
        && correction.requestedBy == request.auth.uid
        && correction.status == 'pending';
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, write: if admin();
      // Only administrators can approve or change role/tenant identifiers.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['college', 'deo', 'diet', 'school']
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'status', 'registrationNumber',
          'role', 'districtId', 'officerName', 'mobile', 'email', 'collegeId',
          'schoolId', 'dietId', 'createdAt']);
    }

    match /students/{studentId} {
      allow read, write: if admin();
      allow read: if studentReadable(resource.data);
      allow update: if college(resource.data)
        && request.resource.data.get('correctionRequestId', '') is string
        && request.resource.data.get('correctionRequestId', '') != ''
        && correctionSubmission(studentId);
      // Preserve proposal submission and district review/assignment fields only.
      allow update: if college(resource.data)
        && resource.data.status in ['created', 'deoRejected']
        && request.resource.data.status == 'proposed'
        && changedOnly(['status', 'proposedSchoolId', 'submittedOn', 'updatedAt']);
      allow update: if district(resource.data) && (
        (role('deo') && request.resource.data.status in ['deoApproved', 'deoRejected']
          && changedOnly(['status', 'proposedSchoolId', 'updatedAt']))
        || (role('diet') && request.resource.data.status == 'assigned_by_diet'
          && changedOnly(['status', 'finalSchoolId', 'updatedAt'])));
    }

    match /correction_requests/{requestId} {
      allow read, write: if admin();
      allow read: if college(resource.data);
      allow create: if college(request.resource.data)
        && request.resource.data.get('studentId', '') is string
        && request.resource.data.get('studentId', '') != ''
        && request.resource.data.requestId == requestId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['requestId', 'studentId',
          'registrationId', 'collegeId', 'districtId', 'requestedBy', 'studentName',
          'fatherName', 'motherName', 'nameCorrectionEnglish', 'namePunjabi',
          'fatherNameCorrectionEnglish', 'fatherNamePunjabi',
          'motherNameCorrectionEnglish', 'motherNamePunjabi', 'certificateFileName',
          'certificateMimeType', 'certificatePdf', 'status', 'createdAt', 'updatedAt'])
        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
        && college(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data);
      // No college update/delete permission, including approve/reject.
    }

    match /exam_eligibility_submissions/{submissionId} {
      allow read: if admin() || college(resource.data)
        || (role('diet') && district(resource.data));
      allow create: if college(request.resource.data)
        && request.resource.data.get('reviewHistory', []).size() == 0
        && validExamEligibilitySubmission(request.resource.data, submissionId);
      allow update: if college(resource.data)
        && resource.data.status == 'needs_correction'
        && changedOnly(['attendedWorkingDays', 'attendancePercentage',
          'tpCertificateFileName', 'tpCertificateMimeType', 'tpCertificatePdf',
          'collegeRemarks', 'status', 'submittedBy', 'submittedAt', 'reviewedBy',
          'reviewedAt', 'dietRemarks', 'eligible', 'reviewHistory', 'updatedAt'])
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.collegeId == resource.data.collegeId
        && request.resource.data.districtId == resource.data.districtId
        && request.resource.data.reviewHistory
          == resource.data.get('reviewHistory', []).concat([
            eligibilityReviewAudit(resource.data)
          ])
        && validExamEligibilitySubmission(request.resource.data, submissionId);
      allow update: if role('diet') && district(resource.data)
        && resource.data.status == 'submitted_to_diet'
        && changedOnly(['status', 'eligible', 'reviewedBy', 'reviewedAt',
          'dietRemarks', 'updatedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.dietRemarks == null
          || request.resource.data.dietRemarks is string)
        && (
          (request.resource.data.status == 'eligible'
            && request.resource.data.eligible == true
            && resource.data.attendedWorkingDays >= 150)
          || (request.resource.data.status == 'not_eligible'
            && request.resource.data.eligible == false
            && resource.data.attendedWorkingDays < 150
            && request.resource.data.dietRemarks is string
            && request.resource.data.dietRemarks != '')
          || (request.resource.data.status == 'needs_correction'
            && request.resource.data.eligible == null
            && request.resource.data.dietRemarks is string
            && request.resource.data.dietRemarks != '')
        );
    }

    // Directory lookups are used before authentication by registration dropdowns.
    match /{directory}/{id} {
      allow read: if directory in ['colleges', 'schools', 'diets'];
      allow write: if directory in ['colleges', 'schools', 'diets'] && admin();
    }
    match /schools/{id} {
      allow update: if role('diet') && district(resource.data)
        && changedOnly(['currentAssignedCount', 'updatedAt'])
        && request.resource.data.currentAssignedCount == resource.data.currentAssignedCount + 1;
    }
    match /proposals/{id} {
      allow read, write: if admin();
      allow read: if college(resource.data) || district(resource.data);
      allow create: if college(request.resource.data)
        && request.resource.data.status == 'pending'
        && college(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data);
      allow update: if district(resource.data) && (
        (role('deo') && request.resource.data.status in ['approved', 'rejected']
          && changedOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason',
            'proposedSchoolId', 'updatedAt']))
        || (role('diet') && request.resource.data.status == 'assigned_by_diet'
          && changedOnly(['status', 'finalAssignedBy', 'finalAssignedAt', 'updatedAt'])));
    }
    match /allocations/{id} {
      allow read, write: if admin();
      allow read: if college(resource.data) || district(resource.data) || school(resource.data);
      allow create: if role('diet') && district(request.resource.data)
        && district(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data)
        && district(get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data);
    }
    match /{collection}/{id} {
      allow read, write: if collection in ['attendance', 'certificates'] && admin();
      // Student-bound lookup also supports existing studentId-only queries.
      allow read: if collection in ['attendance', 'certificates']
        && studentReadable(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data);
      allow create: if collection in ['attendance', 'certificates']
        && school(request.resource.data)
        && studentReadable(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data);
      allow update: if collection in ['attendance', 'certificates']
        && school(resource.data) && school(request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.allocationId == resource.data.allocationId
        && studentReadable(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data);
    }
    // Unmatched collections and subcollections are denied by default.
  }
}
